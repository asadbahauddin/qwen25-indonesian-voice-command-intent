  "items": [
    {"id": "P01", "formality": "formal", "text": "Robot, silakan menuju ke Laboratorium Otomasi.",
     "label": {"intent": "navigate_room", "room": "lab otomasi", "object": null, "person": null, "document": null, "steps": null}},
    {"id": "P02", "formality": "formal", "text": "Mohon pergi ke ruangan Bu Vivi sekarang.",
     "label": {"intent": "navigate_room", "room": "ruang bu vivi", "object": null, "person": null, "document": null, "steps": null}},
    {"id": "P03", "formality": "semi-formal", "text": "Tolong ke ruang asisten ya.",
     "label": {"intent": "navigate_room", "room": "ruang asisten", "object": null, "person": null, "document": null, "steps": null}},
    {"id": "P04", "formality": "semi-formal", "text": "Coba pergi ke ruangan Pak Andi ya.",
     "label": {"intent": "navigate_room", "room": "ruang pak andi", "object": null, "person": null, "document": null, "steps": null}},
    {"id": "P05", "formality": "informal", "text": "Eh robot, cus ke ruang dosen.",
     "label": {"intent": "navigate_room", "room": "ruang dosen", "object": null, "person": null, "document": null, "steps": null}},
    {"id": "P06", "formality": "informal", "text": "Ke ruangan Pak Umam gih, buruan.",
     "label": {"intent": "navigate_room", "room": "ruang pak umam", "object": null, "person": null, "document": null, "steps": null}},

    {"id": "P07", "formality": "formal", "text": "Silakan bergerak menuju mesin CNC.",
     "label": {"intent": "navigate_object", "room": null, "object": "mesin cnc", "person": null, "document": null, "steps": null}},
    {"id": "P08", "formality": "formal", "text": "Mohon menuju ke posisi trainer PLC.",
     "label": {"intent": "navigate_object", "room": null, "object": "trainer plc", "person": null, "document": null, "steps": null}},
    {"id": "P09", "formality": "semi-formal", "text": "Tolong ke dekat lengan robot ya.",
     "label": {"intent": "navigate_object", "room": null, "object": "lengan robot", "person": null, "document": null, "steps": null}},
    {"id": "P10", "formality": "semi-formal", "text": "Coba datangi trainer pneumatik sebentar.",
     "label": {"intent": "navigate_object", "room": null, "object": "trainer pneumatik", "person": null, "document": null, "steps": null}},
    {"id": "P11", "formality": "informal", "text": "Robot, ke deretan komputer sana dong.",
     "label": {"intent": "navigate_object", "room": null, "object": "deretan komputer", "person": null, "document": null, "steps": null}},
    {"id": "P12", "formality": "informal", "text": "Samperin trainer RL itu, cepetan.",
     "label": {"intent": "navigate_object", "room": null, "object": "trainer rangkaian listrik", "person": null, "document": null, "steps": null}},

    {"id": "P13", "formality": "formal", "text": "Mohon carikan keberadaan Pak Umam.",
     "label": {"intent": "find_person", "room": null, "object": null, "person": "pak umam", "document": null, "steps": null}},
    {"id": "P14", "formality": "formal", "text": "Silakan temukan Ibu Vivi.",
     "label": {"intent": "find_person", "room": null, "object": null, "person": "bu vivi", "document": null, "steps": null}},
    {"id": "P15", "formality": "semi-formal", "text": "Tolong cari Pak Kus ya.",
     "label": {"intent": "find_person", "room": null, "object": null, "person": "pak kus", "document": null, "steps": null}},
    {"id": "P16", "formality": "semi-formal", "text": "Coba cari asisten lab sekarang.",
     "label": {"intent": "find_person", "room": null, "object": null, "person": "asisten lab", "document": null, "steps": null}},
    {"id": "P17", "formality": "informal", "text": "Pak Andi di mana sih? Cariin dong.",
     "label": {"intent": "find_person", "room": null, "object": null, "person": "pak andi", "document": null, "steps": null}},
    {"id": "P18", "formality": "informal", "text": "Cari mas asisten gih.",
     "label": {"intent": "find_person", "room": null, "object": null, "person": "asisten lab", "document": null, "steps": null}},

    {"id": "P19", "formality": "formal", "text": "Mohon antarkan laporan praktikum ini kepada Ibu Vivi.",
     "label": {"intent": "deliver_document", "room": null, "object": null, "person": "bu vivi", "document": "laporan praktikum", "steps": null}},
    {"id": "P20", "formality": "formal", "text": "Silakan serahkan surat izin ini ke ruang dosen.",
     "label": {"intent": "deliver_document", "room": "ruang dosen", "object": null, "person": null, "document": "surat izin", "steps": null}},
    {"id": "P21", "formality": "semi-formal", "text": "Tolong bawa berkas tugas akhir ini ke Pak Umam ya.",
     "label": {"intent": "deliver_document", "room": null, "object": null, "person": "pak umam", "document": "berkas tugas akhir", "steps": null}},
    {"id": "P22", "formality": "semi-formal", "text": "Tolong kirim jadwal praktikum ke ruang asisten.",
     "label": {"intent": "deliver_document", "room": "ruang asisten", "object": null, "person": null, "document": "jadwal praktikum", "steps": null}},
    {"id": "P23", "formality": "informal", "text": "Anterin lembar nilai ini ke Pak Kus dong.",
     "label": {"intent": "deliver_document", "room": null, "object": null, "person": "pak kus", "document": "lembar nilai", "steps": null}},
    {"id": "P24", "formality": "informal", "text": "Laprak ini kasih ke Pak Andi ya, buruan.",
     "label": {"intent": "deliver_document", "room": null, "object": null, "person": "pak andi", "document": "laporan praktikum", "steps": null}},

    {"id": "P25", "formality": "formal", "text": "Silakan menuju Laboratorium Otomasi, kemudian carikan Pak Umam.",
     "label": {"intent": "combined_command", "room": null, "object": null, "person": null, "document": null, "steps": [
       {"intent": "navigate_room", "room": "lab otomasi", "object": null, "person": null, "document": null},
       {"intent": "find_person", "room": null, "object": null, "person": "pak umam", "document": null}]}},
    {"id": "P26", "formality": "formal", "text": "Mohon pergi ke ruang asisten, lalu antarkan surat izin kepada Ibu Vivi.",
     "label": {"intent": "combined_command", "room": null, "object": null, "person": null, "document": null, "steps": [
       {"intent": "navigate_room", "room": "ruang asisten", "object": null, "person": null, "document": null},
       {"intent": "deliver_document", "room": null, "object": null, "person": "bu vivi", "document": "surat izin"}]}},
    {"id": "P27", "formality": "semi-formal", "text": "Tolong ke mesin CNC dulu, habis itu ke ruang dosen ya.",
     "label": {"intent": "combined_command", "room": null, "object": null, "person": null, "document": null, "steps": [
       {"intent": "navigate_object", "room": null, "object": "mesin cnc", "person": null, "document": null},
       {"intent": "navigate_room", "room": "ruang dosen", "object": null, "person": null, "document": null}]}},
    {"id": "P28", "formality": "semi-formal", "text": "Coba cari Pak Kus, terus antar laporan praktikum ini ke beliau.",
     "label": {"intent": "combined_command", "room": null, "object": null, "person": null, "document": null, "steps": [
       {"intent": "find_person", "room": null, "object": null, "person": "pak kus", "document": null},
       {"intent": "deliver_document", "room": null, "object": null, "person": "pak kus", "document": "laporan praktikum"}]}},
    {"id": "P29", "formality": "informal", "text": "Ke trainer PLC bentar, abis itu balik ke ruangan Pak Andi.",
     "label": {"intent": "combined_command", "room": null, "object": null, "person": null, "document": null, "steps": [
       {"intent": "navigate_object", "room": null, "object": "trainer plc", "person": null, "document": null},
       {"intent": "navigate_room", "room": "ruang pak andi", "object": null, "person": null, "document": null}]}},
    {"id": "P30", "formality": "informal", "text": "Cariin mas asisten, trus anterin berkas TA ini ke dia.",
     "label": {"intent": "combined_command", "room": null, "object": null, "person": null, "document": null, "steps": [
       {"intent": "find_person", "room": null, "object": null, "person": "asisten lab", "document": null},
       {"intent": "deliver_document", "room": null, "object": null, "person": "asisten lab", "document": "berkas tugas akhir"}]}},

    {"id": "P31", "formality": "formal", "text": "Mohon berhenti sekarang.",
     "label": {"intent": "general_command", "room": null, "object": null, "person": null, "document": null, "steps": null}},
    {"id": "P32", "formality": "formal", "text": "Silakan kembali ke posisi awal.",
     "label": {"intent": "general_command", "room": null, "object": null, "person": null, "document": null, "steps": null}},
    {"id": "P33", "formality": "semi-formal", "text": "Tolong tunggu di sini sebentar ya.",
     "label": {"intent": "general_command", "room": null, "object": null, "person": null, "document": null, "steps": null}},
    {"id": "P34", "formality": "semi-formal", "text": "Coba jalannya pelan-pelan.",
     "label": {"intent": "general_command", "room": null, "object": null, "person": null, "document": null, "steps": null}},
    {"id": "P35", "formality": "informal", "text": "Stop, stop, diem dulu.",
     "label": {"intent": "general_command", "room": null, "object": null, "person": null, "document": null, "steps": null}},
    {"id": "P36", "formality": "informal", "text": "Udah, balik aja ke tempat semula.",
