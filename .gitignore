# Python
.venv/
__pycache__/
*.pyc

# Data hasil eksekusi (folder dipertahankan lewat .gitkeep)
recordings/*
!recordings/.gitkeep
logs/*
!logs/.gitkeep
results/*.wav
results/env_*.json

# Dokumen administrasi MBKM & tanda tangan (bukan bagian kode, jangan di-commit)
*.docx
/*.pdf
/*.jpeg
/*.jpg
/*.png
~$*

# Repo publik: audio responden (luaran HKI, ada consent) & bobot model TIDAK di-commit
dataset/
models/
*.wav

# cadangan lokal dataset (audio responden, jangan di-push)
backup/

# foto dokumentasi pribadi (repo publik)
luaran/foto/

# foto & pindaian kegiatan (wajah/nama responden) - repo publik, jangan di-push
Dokumentasi/*.jpeg
Dokumentasi/*.jpg
Dokumentasi/*.pdf

# data kontak penulis (email/WA) - tidak di-push
luaran/penulis_lokal.json

# berkas unggahan e-HKI (dibuat ulang dari luaran/buat_berkas_hki.*)
HKI/

# keluaran poster (dibuat ulang dari luaran/buat_poster.py)
luaran/poster/*.pdf
